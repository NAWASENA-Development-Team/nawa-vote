":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"use-credentials\"}],[\"$\",\"link\",\"5\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"link\",\"6\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"meta\",\"7\",{\"name\":\"next-size-adjust\"}]]\n1:null\nb:I[28136,[\"762\",\"static/chunks/44530001-9b9daae6bcc8e13c.js\",\"231\",\"static/chunks/231-d137681c98897e35.js\",\"629\",\"static/chunks/629-4047a8dfdc2d7a87.js\",\"682\",\"static/chunks/682-0dcf64da14eb5484.js\",\"944\",\"static/chunks/944-ec1ea9098121292a.js\",\"38\",\"static/chunks/app/(voter)/vote/page-a885e24316f1c13d.js\"],\"default\"]\n2:[\"$\",\"$Lb\",null,{\"candidates\":[{\"id\":\"69263b9b-0f90-47ad-af9f-7a1b3e3d9e5e\",\"ordinal_number\":1,\"name\":\"Zaki Abdul Haq\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/viola.jpeg\",\"vision\":\"Menjadikan OSIS SMAN 2 JONGGOL sebagai organisasi yang bertanggungjawab, mampu bekerja dengan baik, serta memberikan ruang bagi siswa/i untuk menyampaikan ide dan aspirasi\",\"mission\":[\"Aktif dalam mengikuti berbagai kegiatan organisasi\",\"Membangun komunikasi dan kerjasama yang baik antar sesama anggota OSIS\",\"Membangun suasana yang nyaman dan saling menghargai antar anggota OSIS\"],\"category\":\"ketua\"},{\"id\":\"c9d7a3dd-4a67-4c2d-b1f5-9787153ecf4b\",\"ordinal_number\":2,\"name\":\"Muhammad Fadhli Hidayatulloh\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/adi.jpeg\",\"vision\":\"Menjadikan OSIS SMAN 2 Jonggol sebagai wadah aspirasi dan pengembangan potensi siswa yang aktif, inspiratif, kreatif, dan berkarakter dengan berlandaskan iman dan taqwa\",\"mission\":[\"Meningkatkan keimanan dan ketakwaan kepada Tuhan Yang Maha Esa\",\"Mewujudkan OSIS yang inspiratif, sigap, dan bertanggung jawab dalam menjalankan setiap kegiatan\",\"Mengembangkan kreativitas dan potensi siswa melalui kegiatan yang inovatif dan bermanfaat\"],\"category\":\"ketua\"},{\"id\":\"871ef998-1900-4fd4-89bd-f2ae91dc2c10\",\"ordinal_number\":3,\"name\":\"Listiana Dewi\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/Listi.jpeg\",\"vision\":\"Mewujudkan generasi yang beriman, berkarakter, peduli lingkungan, serta memiliki ruang untuk berkembang melalui OSIS yang inspiratif, bertanggung jawab, dan mampu menjadi teladan dalam membawa perubahan\",\"mission\":[\"Menumbuhkan pribadi yang beriman dan berakhlak melalui pembiasaan positif\",\"Membangun budaya sekolah yang bersih melalui gerakan peduli lingkungan serta pengurangan sampah plastik\",\"Menciptakan ruang bagi siswa-siswi untuk berkembang melalui OSIS yang inspiratif, bertanggung jawab, dan mampu menjadi teladan dalam membawa perubahan positif\"],\"category\":\"ketua\"},{\"id\":\"c93198dc-10c9-4e4f-9333-7b5966dc03bc\",\"ordinal_number\":1,\"name\":\"Zaskia Indriani Putri\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/zskia.jpeg\",\"vision\":\"Menjadikan OSIS SMAN 2 Jonggol sebagai wadah yang aktif dan inklusif dalam mengembangkan potensi siswa agar berprestasi, berwawasan luas, berkarakter, kreatif, dan inovatif melalui pengembangan potensi akademik maupun non akademik\",\"mission\":[\"Mengoptimalkan potensi siswa melalui kegiatan akademik maupun akademik sesuai minat dan bakat\",\"Mendorong prestasi, kreativitas, dan inovasi. Serta memberikan apresiasi atas pencapaian siswa\",\"Membentuk jiwa kepemimpinan, tanggung jawab, dan kepedulian siswa melalui lingkungan OSIS yang terbuka dan kolaboratif\"],\"category\":\"wakil_1\"},{\"id\":\"3bc0209b-58cc-46df-acf2-fb776e7a71fb\",\"ordinal_number\":2,\"name\":\"Viola Bintang Putri\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/WhatsApp%20Image%202026-09-21%20at%2020.08.37%20(1).jpeg\",\"vision\":\"Menjadikan OSIS sebagai organisasi yang aktif, adaptif, solutif, dan inovatif dalam mengembangkan potensi diri, membentuk karakter, dan rasa tanggung jawab serta meningkatkan kepedulian terhadap lingkungan\",\"mission\":[\"Menciptakan komunikasi yang transparan dan terbuka dengan sesama anggota dan warga sekolah\",\"Membangun solidaritas dan rasa kekeluargaan dengan menjunjung sikap saling menghormati dan menghargai\",\"Menyelenggarakan kegiatan positif dan inovatif untuk mengembangkan kreativitas siswa\",\"Meningkatkan kepedulian terhadap lingkungan dengan kegiatan menjaga kebersihan, kelestarian, dan kenyamanan lingkungan sekolah\"],\"category\":\"wakil_1\"},{\"id\":\"064bc0dd-b647-47f4-a4ad-a3ccb5d98f85\",\"ordinal_number\":3,\"name\":\"Nadya Koherunnisa\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/nadya.jpeg\",\"vision\":\"Mewujudkan OSIS SMAN negeri 2 Jonggol sebagai organisasi yang terbuka komunikatif dan menjadikan wadah bagi setiap siswa-siswi untuk menyampaikan aspirasi mengembangkan potensi dan menciptakan lingkungan sekolah yang aktif inovatif dan harmonis serta menjadikan ruang bagi setiap anggota OSIS untuk belajar berkembang dan bertumbuh bersama dengan memberikan kontribusi nyata dan dapat terlihat dan dirasakan oleh seluruh siswa\",\"mission\":[\"Menampung dan mengembangkan bakat minat dan kreativitas siswa\",\"mendorong terciptanya kepengurusan OSIS yang aktif, bertanggung jawab dan bekerja sama dengan baik\",\"Mewujudkan pelaksanaan program kerja OSIS yang kreatif terarah dan bermanfaat\",\"Membangun komunikasi yang baik antara siswa, OSIS, dan guru\"],\"category\":\"wakil_1\"},{\"id\":\"d57a2461-ba83-4633-9e24-7c4ff7481c01\",\"ordinal_number\":1,\"name\":\"Agnes Sifra Ginting\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/agnes.jpeg\",\"vision\":\"Mewujudkan OSIS SMAN 2 Jonggol sebagai wadah yang aktif, kreatif, dan positif bagi siswa, serta menjadi bagian dalam menciptakan lingkungan sekolah yang bersih dan nyaman\",\"mission\":[\"Mendorong siswa untuk lebih disiplin dan peduli terhadap lingkungan sekolah\",\"Mengembangkan kegiatan yang menjadi wadah bagi minat, bakat, dan kreativitas siswa\",\"Mendengar, menampung, dan menyampaikan aspirasi siswa sebagai bagian dari perkembangan sekolah\",\"Menciptakan kegiatan sekolah yang menarik, bermanfaat, dan dapat melibatkan lebih banyak siswa\"],\"category\":\"wakil_2\"},{\"id\":\"58278d1b-7896-41c8-8363-ed20cfbcf852\",\"ordinal_number\":2,\"name\":\"Dilla Adelia Rahma\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/dilla.jpeg\",\"vision\":\"Membangun organisasi yang berkarakter S.I.S.W.A (Solid, Inspiratif, Solutif, Wirakarya, Aktif) sebagai wadah kolaboratif untuk mengembangkan potensi, minat bakat dan karakter siswa\",\"mission\":[\"Membangun rasa kekeluargaan dan kerja sama antar seluruh siswa, pengurus dan warga sekolah untuk mewujudkan lingkungan yang kokoh dan kompak\",\"Menjadi penggerak yang aktif dan inspiratif dengan menciptakan kegiatan yang positif, kreatif dan membangun karakter teladan\",\"Menjadikan OSIS organisasi yang responsif dan mampu menyelesaikan masalah dalam menampung serta menindaklanjuti aspirasi siswa\",\"Mengaktifkan minat dan bakat siswa melalui ekstrakurikuler dan gelar karya sebagai wadah ekspresif dan prestasi\"],\"category\":\"wakil_2\"},{\"id\":\"f6cb6a89-6f5f-48fe-a1af-bd0618b30eec\",\"ordinal_number\":3,\"name\":\"Kyna Barrah Amanda\",\"photo_url\":\"https://fftjbkxjjhpevffkeayn.supabase.co/storage/v1/object/public/candidate/kyna.jpeg\",\"vision\":\"MENJADIKAN OSIS SEBAGAI\\n\\nWADAH BAGI SISWA UNTUK\\n\\nBERANI (BERKARYA. EKSPRESIF. RESPONSIF. AKTIF. NASIONALIS. DAN INSPIRATIF) SERTA\\n\\nMENCIPTAKAN LINGKUNGAN SEKOLAH YANG NYAMAN. POSITIF. DAN PENUH KESEMPATAN UNTUK BERKEMBANG\",\"mission\":[\"MENGEMBANGKAN POTENSI SISWA MEMBANTU SISWA UNTUK MENGENALI DAN MENGEMBANGKAN MINAT SERTA BAKAT YANG MEREKA PUNYA\",\"MEMBANGUN KOMUNIKASI YANG BAIK MENCIPTAKAN KOMUNIKASI YANG TERBUKA ANTARA SISWA.  OSIS DAN PIHAK SEKOLAH.\",\"MENDENGARAN ASPIRASI SISWA & DIKEMBANGKAN MENJADI AKSI NYATA\",\"MEMBANGUN RASA KOMPAK DAN SALING MENGHARGAI\",\"MENDORONG SISWA UNTUK LEBIH AKTIF ANTAR SISWA DI SEKOLAH.\"],\"category\":\"wakil_2\"}],\"voterToken\":\"NW-AF98WV\",\"voterId\":\"342000b1-2fe4-47ed-b4a6-71b9041d3e45\"}]\n"
