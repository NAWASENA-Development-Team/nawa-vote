{"nodes": [{"id": "agent_guidelines", "label": "NAWA-VOTE Agent Workflow & Guidelines", "file_type": "document", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_modular_dynamic_code_architecture", "label": "Modular & Dynamic Code Architecture", "file_type": "rationale", "rationale": "Keep UI components decoupled and reusable across views; define TypeScript interfaces for component props and data models to avoid static hardcoded data in UI templates.", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_clean_layer_separation", "label": "Clean Layer Separation", "file_type": "rationale", "rationale": "Encapsulate Supabase database operations, authentication routines, and mutation logic within Server Actions; handle user interactions, framer-motion animations, and local UI state in Client Components; use standard Tailwind utility classes backed by CSS variables in globals.css.", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_civic_institutional_identity", "label": "Civic & Institutional Identity", "file_type": "rationale", "rationale": "The application serves Indonesian student elections (Pilketos). Maintain an official, trustworthy tone with brand-navy deep blue and brand-amber gold palette, Plus Jakarta Sans headings, and Inter body typography.", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_hydration_safe_dark_mode", "label": "Hydration-Safe Dark Mode", "file_type": "rationale", "rationale": "Every component must support both Light and Dark modes. Always pair light utilities with explicit dark counterparts and avoid static white background rules on containers intended to carry dark utility backgrounds.", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_smooth_micro_interactions", "label": "Smooth Micro-Interactions", "file_type": "rationale", "rationale": "Maintain fluid CSS color transitions and ensure interactive buttons, modals, badges, and form controls feature active states, clear disabled indicators, and smooth entry/exit animations via framer-motion.", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_workflow_commitment_protocol", "label": "Workflow & Commitment Protocol", "file_type": "rationale", "rationale": "Use bun for all package scripts, verify zero TypeScript errors or compilation breaks with bun run build before completion, and commit immediately using conventional commit format.", "source_file": "AGENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_guidelines", "target": "agent_modular_dynamic_code_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENT.md", "source_location": null, "weight": 1.0}, {"source": "agent_guidelines", "target": "agent_clean_layer_separation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENT.md", "source_location": null, "weight": 1.0}, {"source": "agent_guidelines", "target": "agent_civic_institutional_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENT.md", "source_location": null, "weight": 1.0}, {"source": "agent_guidelines", "target": "agent_hydration_safe_dark_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENT.md", "source_location": null, "weight": 1.0}, {"source": "agent_guidelines", "target": "ag