      "id": "agent_modular_dynamic_code_architecture",
      "label": "Modular & Dynamic Code Architecture",
      "file_type": "rationale",
      "rationale": "Keep UI components decoupled and reusable across views; define TypeScript interfaces for component props and data models to avoid static hardcoded data in UI templates.",
      "source_file": "C:\\Users\\Stark\\Documents\\nawavote\\AGENT.md",
      "source_location": null,
