    },
    {
      "id": "agent_civic_institutional_identity",
      "label": "Civic & Institutional Identity",
      "file_type": "rationale",
      "rationale": "The application serves Indonesian student elections (Pilketos). Maintain an official, trustworthy tone with brand-navy deep blue and brand-amber gold palette, Plus Jakarta Sans headings, and Inter body typography.",
