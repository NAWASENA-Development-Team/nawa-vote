    },
    {
      "id": "agent_clean_layer_separation",
      "label": "Clean Layer Separation",
      "file_type": "rationale",
      "rationale": "Encapsulate Supabase database operations, authentication routines, and mutation logic within Server Actions; handle user interactions, framer-motion animations, and local UI state in Client Components; use standard Tailwind utility classes backed by CSS variables in globals.css.",
      "source_file": "C:\\Users\\Stark\\Documents\\nawavote\\AGENT.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
